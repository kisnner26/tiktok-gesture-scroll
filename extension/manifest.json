{
  "manifest_version": 3,
  "name": "TikTok Gesture Scroll",
  "version": "0.2.1",
  "description": "Pasa de video en TikTok con un gesto de la mano frente a la webcam. Todo corre en tu equipo.",
  "minimum_chrome_version": "116",
  "permissions": ["offscreen", "storage"],
  "host_permissions": ["https://www.tiktok.com/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": {
    "default_title": "TikTok Gesture Scroll",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" }
  },
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" },
  "content_scripts": [
    {
      "matches": ["https://www.tiktok.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
